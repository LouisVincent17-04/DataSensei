APP_NAME=DataSensei
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=datasensei
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=240
SESSION_IDLE_TIMEOUT=240
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Example SMTP settings (replace with your provider values)
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Isolated Python execution (build docker/python-runner before use)
PYTHON_SANDBOX_DRIVER=docker
PYTHON_SANDBOX_DOCKER_IMAGE=datasensei-python-runner:latest
PYTHON_SANDBOX_DOCKER_NETWORK=none
PYTHON_SANDBOX_TIMEOUT=10
PYTHON_SANDBOX_MAX_CONCURRENT=8
PYTHON_SANDBOX_MEMORY=512m
PYTHON_SANDBOX_MEMORY_SWAP=512m
PYTHON_SANDBOX_CPUS=0.50
PYTHON_SANDBOX_PIDS_LIMIT=64
PYTHON_SANDBOX_READ_ONLY_ROOT=true
PYTHON_SANDBOX_CAP_DROP_ALL=true
PYTHON_SANDBOX_NO_NEW_PRIVILEGES=true
PYTHON_SANDBOX_ALLOW_UNSAFE_LOCAL=false
# Allow eval(), exec() and compile() in student code. The container is the real
# security boundary; leave this false unless a lesson needs them.
PYTHON_ALLOW_DYNAMIC_EXECUTION=false

# Optional local AI reviewer
# The model must be pulled first: ollama pull qwen2.5-coder:1.5b-instruct
# Use an "-instruct" model. Base models ignore the JSON format the reviewer
# asks for, and every review then falls back to "Not Reviewed".
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:1.5b-instruct
# Seconds allowed for a follow-up question (max 60).
OLLAMA_TIMEOUT=30
# Auto-review fires on every Run, so it gets a tighter budget than chat.
OLLAMA_REVIEW_TIMEOUT=20
# Straight-line beginner Python that ran cleanly is reviewed instantly on the
# server with no model call. Set to false to send every submission to Ollama.
CODE_REVIEW_FAST_PATH=true
OLLAMA_MAX_CONCURRENT=4
OLLAMA_MAX_RESPONSE_CHARS=5000
# A review that needs longer than OLLAMA_REVIEW_TIMEOUT keeps running in the
# background and appears in the IDE panel when it finishes (0 = no time limit).
OLLAMA_BACKGROUND_CONTINUATION=true
OLLAMA_BACKGROUND_TIMEOUT=0

# Password reset OTP
PASSWORD_OTP_LENGTH=6
PASSWORD_OTP_EXPIRES_MINUTES=5
PASSWORD_OTP_COOLDOWN_SECONDS=60
PASSWORD_OTP_MAX_VERIFY_ATTEMPTS=5
PASSWORD_OTP_RESET_WINDOW_MINUTES=10
PASSWORD_OTP_DELETE_AFTER_HOURS=24
PASSWORD_OTP_REQUESTS_PER_MINUTE=3
PASSWORD_OTP_REQUESTS_PER_HOUR=10
PASSWORD_OTP_VERIFY_PER_MINUTE=10
PASSWORD_OTP_RESET_PER_MINUTE=5
PASSWORD_RESET_MIN_LENGTH=8
PASSWORD_RESET_CHECK_COMPROMISED=false

# Hybrid Machine Learning module
ML_QUEUE_CONNECTION=machine_learning
ML_QUEUE_NAME=machine-learning
ML_QUEUE_RETRY_AFTER=1200
ML_RUNNER_DRIVER=docker
ML_RUNNER_IMAGE=datasensei-python-runner:latest
ML_DOCKER_BINARY=docker
ML_TRAINING_TIMEOUT=600
ML_PREDICTION_TIMEOUT=30
ML_RUNNER_MEMORY=768m
ML_RUNNER_MEMORY_SWAP=768m
ML_RUNNER_CPUS=1.0
ML_RUNNER_PIDS_LIMIT=96
ML_MAX_UPLOAD_KB=10240
ML_MAX_ROWS=50000
ML_MAX_COLUMNS=200
ML_PREVIEW_ROWS=20
ML_MAX_VERSIONS=0
ML_MAX_PREDICTION_HISTORY=100
ML_TEMP_RETENTION_HOURS=24
# Start a short-lived ML worker automatically when training is queued and
# start-ml-worker.bat is not running.
ML_AUTO_START_WORKER=true

# PHP used for background processes. Leave empty with "php artisan serve";
# set it when the site runs under Apache, e.g. C:\xampp\php\php.exe
DATASENSEI_PHP_BINARY=

# Legacy Model Development settings (retained for old run history)
MODEL_DEVELOPMENT_MAX_ROWS=1000
MODEL_DEVELOPMENT_MAX_FEATURES=12
MODEL_DEVELOPMENT_MAX_CATEGORIES=50
MODEL_DEVELOPMENT_TIMEOUT=25
MODEL_DEVELOPMENT_MAX_PREDICTIONS=30
